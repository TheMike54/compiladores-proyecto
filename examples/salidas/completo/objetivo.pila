FUNC fibonacci n
LOAD n
PUSH 2
LT
STORE @t1
LOAD @t1
JZ @L1
LOAD n
RET
LABEL @L1
LOAD n
PUSH 1
SUB
STORE @t2
LOAD @t2
CALL fibonacci 1
STORE @t3
LOAD n
PUSH 2
SUB
STORE @t4
LOAD @t4
CALL fibonacci 1
STORE @t5
LOAD @t3
LOAD @t5
ADD
STORE @t6
LOAD @t6
RET
FUNC es_par x
LOAD x
PUSH 2
MOD
STORE @t7
LOAD @t7
PUSH 0
EQ
STORE @t8
LOAD @t8
RET
FUNC mostrar_serie limite
PUSH 0
STORE i
LABEL @L2
LOAD i
LOAD limite
LT
STORE @t9
LOAD @t9
JZ @L3
LOAD i
CALL fibonacci 1
STORE @t10
LOAD @t10
PRINT
LOAD i
PUSH 1
ADD
STORE @t11
LOAD @t11
STORE i
JMP @L2
LABEL @L3
RET
LABEL @main
PUSH 11
CALL mostrar_serie 1
PUSH 10
CALL fibonacci 1
STORE @t12
LOAD @t12
STORE total
LOAD @t12
CALL es_par 1
STORE @t13
LOAD @t13
STORE par
LOAD total
PRINT
LOAD @t13
NOT
STORE @t14
LOAD total
PUSH 50
GT
STORE @t15
LOAD @t14
LOAD @t15
AND
STORE @t16
LOAD @t16
PUSH false
OR
STORE @t17
LOAD @t17
JZ @L4
PUSH true
PRINT
JMP @L5
LABEL @L4
LOAD par
JZ @L6
PUSH false
PRINT
JMP @L7
LABEL @L6
PUSH 0
PRINT
LABEL @L7
LABEL @L5
PUSH 3
STORE resta
PUSH 3
PRINT
HALT
